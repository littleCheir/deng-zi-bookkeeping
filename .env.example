# 复制为 .env 后再按需修改；.env 已被 .gitignore 忽略，禁止提交真实密码。
MYSQL_DATABASE=expense_tracker
MYSQL_USER=expense_tracker
MYSQL_PASSWORD=replace-with-strong-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password

# 初始所有者账号（首次启动时创建；已存在则不会重置密码）
APP_INITIAL_OWNER_USERNAME=owner
APP_INITIAL_OWNER_PASSWORD=replace-with-strong-login-password

# 对外暴露的 HTTP 端口
WEB_PORT=80

# 如果通过 HTTPS 反向代理访问，设为 true，让会话/CSRF Cookie 带 Secure
SESSION_COOKIE_SECURE=false
